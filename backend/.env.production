# Railway production — paste into Shared Variables so BOTH services get them.
#
# api and worker must agree on JWT_SECRET, the database, Redis and storage.
# A value set on only one of them is the failure mode this file exists to
# prevent.
#
# Prefer Railway references over hardcoded hostnames:
#   POSTGRES_HOST=${{Postgres.PGHOST}}   REDIS_URL=${{Redis.REDIS_URL}}

# --- Database ---
POSTGRES_USER=noey
POSTGRES_PASSWORD=
POSTGRES_DB=noey_tiktok
POSTGRES_HOST=noey-postgres.railway.internal
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://noey-redis.railway.internal:6379/0

# --- Auth ---
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# The SAME value on api and worker. Both refuse to start without it against a
# non-local database — a token signed with the repo's placeholder can be forged
# for any account, admin included.
JWT_SECRET=
ALLOW_REGISTRATION=false

# --- Seed admin (created on the first boot against an empty database) ---
SEED_EMAIL=
ADMIN_PASSWORD=

# --- CORS: the browser origins allowed to call this API ---
# The web build's own origin. A change needs an API restart.
FRONTEND_URL=https://noey-web-production.up.railway.app
CORS_EXTRA_ORIGINS=

# --- AI (one provider) ---
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.7-flash
LLM_VISION_MODEL=gemini/gemini-3.1-pro-preview
LLM_VISION_EFFORT=medium
LLM_WEB_SEARCH_ENABLED=true

# --- Speech-to-text ---
# The WORKER transcribes, so this must reach it too.
ELEVENLABS_API_KEY=
ELEVENLABS_LANGUAGE=th

# --- Storage ---
# api and worker are separate hosts on Railway and do not share a disk, so ONE
# of these two is mandatory:
#
#   (a) a volume mounted at the same path on both services, named here; or
#   (b) S3/R2 below, which every stored file is mirrored to and read back from.
#
# With neither, project files, the HEVC conversion and the storage quota all
# break in ways that look like missing files rather than missing configuration.
DATA_DIR=/data

S3_BUCKET=noey-videos
S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com   # R2 only; unset on AWS
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Encryption for AI keys stored in the DB ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# UNSET means those keys are stored and returned as PLAINTEXT.
ENCRYPTION_KEY=

# --- Plan limits (0 = unlimited). Defaults are 10 GB / 10M tokens. ---
# PLAN_FREE_STORAGE_BYTES=10737418240
# PLAN_PRO_STORAGE_BYTES=10737418240
