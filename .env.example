# Copy to .env and fill in. NEVER commit .env (and per project rule, nothing is
# committed at all).
#
# This file mirrors backend/packages/core/settings.py, grouped the same way.
# Anything not listed there is ignored silently (`extra="ignore"`), so a
# variable that looks meaningful but steers nothing is a real trap — that is
# what happened to DUB_COMPOSE_MODEL, now deleted.
#
# .env files are DEVELOPMENT only. backend/.dockerignore excludes them and the
# image never contains one, so every production value comes from the process
# environment. See docs/railway-deploy.md.

# ═══ Required ══════════════════════════════════════════════════════════════
# Without these the app either refuses to start or fails on first use.

# --- Database ---
POSTGRES_USER=noey
POSTGRES_PASSWORD=change_me
POSTGRES_DB=noey_tiktok
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Background workers (arq / Redis) ---
# In docker-compose: REDIS_URL=redis://redis:6379/0
REDIS_URL=redis://localhost:6380/0   # host port 6380 maps to container 6379

# --- Auth (JWT) ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
#
# The value below is a PLACEHOLDER published in this repository: anything signed
# with it can be forged by anyone who can read the source. The API and worker
# both REFUSE TO START with it when POSTGRES_HOST is not a local host — see
# assert_production_secrets(). Both services must carry the SAME value.
JWT_SECRET=dev_change_me_in_production
JWT_ACCESS_TTL=1800       # 30 min
JWT_REFRESH_TTL=1209600   # 14 days
# Self-service sign-up (POST /auth/register). Off until the owner opens it.
ALLOW_REGISTRATION=false

# --- Seed admin (scripts/migrate_to_multitenant.py, run at API startup) ---
# A fresh database is seeded with this account, is_admin=true. Leaving
# ADMIN_PASSWORD unset on a real deployment is refused at startup for the same
# reason as JWT_SECRET: the fallback is printed in the repository.
SEED_EMAIL=admin@noey.local
ADMIN_PASSWORD=ChangeMe123!

# --- AI ---
# One provider for everything a model does.
GEMINI_API_KEY=
LLM_MODEL=gemini/gemini-3.7-flash
LLM_VISION_MODEL=gemini/gemini-3.1-pro-preview

# --- Speech-to-text (required for talking_head and both speech modes) ---
# Must be set on the WORKER as well as the API — the worker is what transcribes.
ELEVENLABS_API_KEY=

# --- CORS (which browser origins may call the API) ---
# FRONTEND_URL names one origin; CORS_EXTRA_ORIGINS is a comma-separated list
# for the rest. A change needs an API RESTART (settings are cached).
# On a local database both dev ports are allowed automatically, so neither is
# needed for development.
FRONTEND_URL=http://localhost:5174
CORS_EXTRA_ORIGINS=

# ═══ Storage ═══════════════════════════════════════════════════════════════

# Where uploads, renders and web project files live. UNSET means backend/data,
# which inside a container is part of the image — a redeploy takes every byte
# with it. Any real deployment must point this at a mounted volume, and the API
# and worker must point at the SAME one.
# DATA_DIR=/data

# S3 / Cloudflare R2 — the alternative to a shared volume when API and worker
# are separate hosts. Off unless bucket + both credentials are set;
# S3_ENDPOINT_URL is required for R2 and left unset on plain AWS.
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=auto

# ═══ Optional ══════════════════════════════════════════════════════════════

# --- Billing (Stripe) — docs/billing-stripe.md ---
# With the key OR the webhook secret unset, every /billing action answers 503
# and nothing else changes. Set them on the API service only.
#
# A RESTRICTED key (rk_…) with only the permissions in the doc is the
# recommendation; a full secret key (sk_…) also works. Never commit either.
# STRIPE_SECRET_KEY=rk_test_...
# Signing secret of the endpoint that targets https://<api-host>/billing/webhook
# (locally: printed by `stripe listen --forward-to localhost:8000/billing/webhook`).
# STRIPE_WEBHOOK_SECRET=whsec_...
# Printed by `python scripts/stripe_seed.py`. Unset → the account's default portal.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Marketing site origin: Checkout/portal return here, and it is allowed by CORS.
# On a real deployment a localhost value keeps billing OFF (503).
# SITE_URL=http://localhost:3000
# Stripe Tax on Checkout. Needs a head-office address + an active registration
# first, and is not available to a business located in Thailand — keep false.
# BILLING_AUTOMATIC_TAX=false

# --- Registration bot check (Cloudflare Turnstile) ---
# When set, POST /auth/register, /auth/forgot-password and /contact require
# `turnstile_token` (verified server-side).
# TURNSTILE_SECRET_KEY=

# --- Transactional email (SendGrid) — docs/email-sendgrid.md ---
# Unset key or sender → verification/reset/change-email/contact answer 503;
# registration still succeeds and logs that the mail was skipped.
# A RESTRICTED key with only "Mail Send" access. Never commit it.
# SENDGRID_API_KEY=SG....
# Must be on a domain authenticated in SendGrid (SPF/DKIM), else SendGrid 403s.
# EMAIL_FROM_ADDRESS=hello@mail.example.com
# EMAIL_FROM_NAME=Noey Studio
# Where POST /contact delivers (Reply-To is the visitor). Unset → /contact 503.
# CONTACT_TO_EMAIL=
# Unverified, non-admin accounts cannot START paid AI work (403).
# REQUIRE_VERIFIED_EMAIL_FOR_AI=true

# --- Client IP for rate limits ---
# Trusted reverse proxies appending to X-Forwarded-For in front of the API.
# 0 = the socket peer. Railway: 1 (see docs/email-sendgrid.md). Rate-limit
# counters live in REDIS_URL; if Redis is down the limits fail open.
# TRUSTED_PROXY_HOPS=0

# --- Encryption (Fernet) for API keys stored in the DB ---
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# UNSET means those keys are stored and returned as PLAINTEXT (dev only).
# ENCRYPTION_KEY=

# --- API surface ---
# /docs, /redoc and /openapi.json. Off by default: the schema lists every route
# with its docstring, and those docstrings name the providers.
# API_DOCS_ENABLED=false

# --- Video processing ---
# ffmpeg is auto-discovered from PATH (and WinGet on Windows); set to override.
# FFMPEG_PATH=C:\path\to\ffmpeg.exe

# --- LLM tuning ---
# LLM_BASE_URL=http://localhost:11434   # a local endpoint, e.g. ollama
# LLM_EFFORT=                           # low | medium | high
# LLM_VISION_EFFORT=medium
# LLM_TIMEOUT_SEC=300
# LLM_VISION_TIMEOUT_SEC=900
# LLM_MAX_RETRIES=2
# LLM_WEB_SEARCH_ENABLED=true

# --- Cut / effects model tuning (packages/video) ---
# DUB_VISION_MODEL=gemini-3.1-pro-preview
# DUB_VISION_EFFORT=medium
# DUB_VISION_TIMEOUT_SEC=1200
# DUB_VISION_FPS=0                      # 0 = provider default (~1 fps)
# DUB_PROMPT_VERSION=v2                 # v1 restores the previous prompts
# DUB_ENGINE_LITE=gemini-3.7-flash
# DUB_ENGINE_PRO=gemini-3.8-flash
# DUB_PRECISION_HIGH_FPS=5
# SPEECH_SELECT_MODEL=                  # empty → falls back to DUB_VISION_MODEL
# CUT_STYLE_REF_FPS=0
# EFFECTS_VISION_MODEL=gemini-3.1-pro-preview
# EFFECTS_VISION_EFFORT=high
# EFFECTS_VISION_TIMEOUT_SEC=900

# --- Speech-to-text tuning ---
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_LANGUAGE=th               # "" = auto-detect (risks drift)
# ELEVENLABS_TIMESTAMPS_GRANULARITY=character   # "word" halves the response size
# ELEVENLABS_NO_VERBATIM=true          # model strips fillers / false starts
# ELEVENLABS_TAG_AUDIO_EVENTS=true     # laughter/applause — the only silence kept
# ELEVENLABS_DIARIZE=false             # on: drop words outside the main speaker
# ELEVENLABS_MIN_WORD_LOGPROB=-2.0     # tune with scripts/probe_elevenlabs.py
# ELEVENLABS_SEED=1                    # fixed seed = a re-run cuts the same way
# ELEVENLABS_STT_TIMEOUT_SEC=2400

# --- Plan limits (0 = unlimited) ---
# Tokens are per rolling UTC day; the env names keep the "_MONTHLY_" spelling
# for backward compatibility only.
# PLAN_FREE_MONTHLY_TOKENS=10000000
# PLAN_LITE_MONTHLY_TOKENS=1000000       # PLACEHOLDER — not costed yet
# PLAN_STARTER_MONTHLY_TOKENS=2000000
# PLAN_PRO_MONTHLY_TOKENS=10000000
# PLAN_STUDIO_MONTHLY_TOKENS=20000000    # PLACEHOLDER — not costed yet
# PLAN_ENTERPRISE_MONTHLY_TOKENS=0
# Server storage per plan, in bytes. 10 GB for free/starter/pro (the pricing
# design says 1 / 5 / 10 GB — the owner's call), 3 GB lite, 30 GB studio.
# PLAN_FREE_STORAGE_BYTES=10737418240
# PLAN_LITE_STORAGE_BYTES=3221225472
# PLAN_STARTER_STORAGE_BYTES=10737418240
# PLAN_PRO_STORAGE_BYTES=10737418240
# PLAN_STUDIO_STORAGE_BYTES=32212254720
# PLAN_ENTERPRISE_STORAGE_BYTES=0
