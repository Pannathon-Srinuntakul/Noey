# Static host for the browser build.
#
# A TEMPLATE, not a finished config: the nginx image's own entrypoint
# (/docker-entrypoint.d/20-envsubst-on-templates.sh) runs envsubst over
# everything in /etc/nginx/templates and writes the result to conf.d.
#
# That exists here for one reason: `${PORT}`. A platform that assigns the port
# at run time — Railway, Cloud Run, Heroku — routes to whatever it put in $PORT
# and a server hard-coded to :80 answers nothing, which surfaces as a 502 with
# no log line in the container to explain it (seen on the first deploy,
# 2026-09-08). The Dockerfile sets PORT=80 so a plain `docker run` is unchanged.
#
# envsubst only substitutes variables that exist in the environment, so nginx's
# own `$uri` is left alone.
#
# The app has no URL routing of its own (lib/router.tsx is an in-memory stack),
# so every path falls back to index.html. What the rest of this file exists for
# is the two files that must NOT be treated like ordinary assets.

# The response headers every answer carries. nginx's `add_header` is NOT
# inherited into a `location` that sets any add_header of its own — the
# inner block's list REPLACES the outer one — so each location below that
# adds a Cache-Control repeats these. Change them in every copy.
#
#   nosniff            — a served file is only ever what its type says.
#   Referrer-Policy    — a project uid in a path never reaches another site.
#   Permissions-Policy — camera and geolocation are never used; the
#                        microphone IS (the voiceover recorder), so it is
#                        deliberately not listed.
#   frame-ancestors    — the meta CSP in index.html cannot express this
#                        directive (browsers ignore it there), and it is the
#                        one that stops the editor being framed by another
#                        site for clickjacking.

server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;

    # Text assets compressed on the way out. The main bundle is a few MB of
    # JavaScript; on a phone over mobile data that is the difference between
    # the editor opening and the viewer giving up. Media is never in the list:
    # it is already compressed, and it is served by the worker anyway.
    gzip on;
    gzip_types application/javascript text/css image/svg+xml application/json application/wasm;
    gzip_min_length 1024;
    gzip_vary on;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), geolocation=()" always;
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # The service worker must be served from the ROOT path, uncached.
    #
    # Its scope is the origin, so a copy served from /assets/ would control
    # nothing and every `/media/...` request — every clip preview and every
    # source a render reads — would 404. `no-store` is what lets a deploy
    # actually replace it: a cached worker keeps serving the old code for as
    # long as the browser keeps it, on a file whose whole job is to change
    # behaviour between versions.
    location = /media-sw.js {
        add_header Cache-Control "no-store" always;
        add_header Service-Worker-Allowed "/" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
        try_files $uri =404;
    }

    # Same reasoning: the shell names the hashed bundles, so a cached shell
    # points at files a new deploy has removed.
    location = /index.html {
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # Hashed filenames — safe to keep for a year.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), geolocation=()" always;
        add_header Content-Security-Policy "frame-ancestors 'none'" always;
    }

    # /media/ belongs to the service worker alone. Before the worker controls
    # the page (first visit, hard reload) these requests reach nginx, and the
    # SPA fallback answered them 200 + index.html — which made every "does
    # this file exist" probe say yes and handed <video> an HTML document.
    location /media/ {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
