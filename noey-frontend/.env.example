# Noey Studio marketing + account site (noey-frontend)
# Copy to .env.local for local development. NEXT_PUBLIC_* values are inlined
# into the build, so changing them requires a rebuild.

# Public origin of this site. Drives canonicals, sitemap, og:url, JSON-LD and
# robots.txt. No trailing path.
NEXT_PUBLIC_SITE_URL=https://noeystudio.com

# FastAPI backend, called ONLY from this site's server (never from browsers).
# The backend also sends every email (SendGrid): contact form, email
# verification, password reset.
API_URL=http://localhost:8000

# The editor web app ("ไปที่แอป" / "เปิดแอปตัดต่อ"). Local web dev server shown here.
NEXT_PUBLIC_APP_URL=http://localhost:5174

# Cloudflare Turnstile site key. When empty, no widget and no third-party
# script is rendered (sign-up, contact form, forgot-password dialog); the
# backend decides whether a token is required.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public contact address: shown under the contact form and offered as the
# mailto fallback when the backend cannot send email (503).
CONTACT_EMAIL=hello@noeystudio.com

# Shared with the admin app (admin/): lets it refresh the price pages right
# after an admin changes a plan price (POST /api/revalidate-prices). Empty =
# that route is off and prices refresh within 10 minutes on their own.
PRICES_REVALIDATE_SECRET=

# Sign in with Google needs NO variable here: the backend holds the Google
# client id/secret. It shows the button once GET /auth/google/config says
# enabled. Register `${NEXT_PUBLIC_SITE_URL}/auth/google/callback` EXACTLY
# (scheme, host, path, no trailing slash) both in Google Cloud Console
# ("Authorized redirect URIs") and in the backend's GOOGLE_REDIRECT_URIS.
# For local dev set NEXT_PUBLIC_SITE_URL=http://localhost:3000 and register
# http://localhost:3000/auth/google/callback too.

# Error monitoring (Sentry). Empty = the SDK is never loaded and the CSP is
# unchanged. A DSN is public by design (it can only submit events). Build-time:
# rebuild after changing. The CSP connect-src gains only this DSN's host.
NEXT_PUBLIC_SENTRY_DSN=
# Optional: environment tag (default production/development), release tag,
# and trace sampling 0..1 (default 0 = errors only).
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=

# Search engine ownership verification (content of the meta tag only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Only when running MORE THAN ONE instance: the same random base64 key on
# every instance, or Server Actions fail across instances (Next.js variable).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# NOTE: no Stripe or email-provider keys here. Checkout, plan changes, the
# customer portal and all email are handled by the backend.
